{
  "name": "japa-functions",
  "version": "1.0.0",
  "description": "Seli Backend - Firebase Cloud Functions",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "seed": "npm run build && node lib/scripts/seed-all.js",
    "seed:emulator": "npm run build && GCLOUD_PROJECT=japa-platform FIRESTORE_EMULATOR_HOST=localhost:8080 FIREBASE_AUTH_EMULATOR_HOST=localhost:9099 node lib/scripts/seed-all.js",
    "seed:dev": "npm run build && node lib/scripts/seed-all.js --project durin-seli-dev",
    "seed:prod": "npm run build && node lib/scripts/seed-prod-bootstrap.js --project japa-platform",
    "seed:prod:full": "npm run build && node lib/scripts/seed-all.js --project japa-platform",
    "sync:visa-sources": "npm run build && node lib/scrapers/visa-catalog/scripts/sync-visa-sources.js",
    "remediate:sources-107": "npm run build && node lib/scrapers/shared/scripts/remediate-failing-sources.js",
    "paystack:sync": "npm run build && node lib/scripts/sync-paystack-plans.js",
    "paystack:sync:dev": "npm run build && node lib/scripts/sync-paystack-plans.js --project durin-seli-dev",
    "paystack:sync:prod": "npm run build && node lib/scripts/sync-paystack-plans.js --project japa-platform",
    "admin:grant": "npm run build && node lib/scripts/grant-admin.js",
    "admin:revoke": "npm run build && node lib/scripts/grant-admin.js --revoke",
    "audit:roles": "npm run build && node lib/scripts/audit-role-trust.js",
    "backfill:slugs": "npm run build && node lib/scripts/backfill-agency-slugs.js",
    "backfill:slugs:dev": "npm run build && GCLOUD_PROJECT=durin-seli-dev node lib/scripts/backfill-agency-slugs.js",
    "backfill:agentids": "npm run build && node lib/scripts/backfill-application-agent-ids.js",
    "backfill:agentids:dev": "npm run build && GCLOUD_PROJECT=durin-seli-dev node lib/scripts/backfill-application-agent-ids.js",
    "backfill:visas": "npm run build && node lib/scripts/backfill-visa-ownership.js",
    "backfill:visas:dev": "npm run build && GCLOUD_PROJECT=durin-seli-dev node lib/scripts/backfill-visa-ownership.js",
    "test": "tsc -p tsconfig.test.json && node --import tsx --import ./test/helpers/setup.ts --test 'test/**/*.test.ts'",
    "test:emulator": "firebase emulators:exec --config ../firebase.emulator-test.json --project demo-seli-emulator-test --only auth,firestore,storage \"node --import tsx --import ./test/emulator/setup.ts --test --test-concurrency=1 'test/emulator/*.emu.ts'\"",
    "eval:visa-extract": "node --env-file-if-exists=.env.local --import tsx src/scrapers/visa-catalog/eval/run.ts",
    "eval:record": "node --import tsx src/scrapers/visa-catalog/eval/record.ts",
    "lint": "eslint --ext .ts src/ test/",
    "lint:fix": "eslint --ext .ts src/ test/ --fix",
    "clean": "rm -rf lib",
    "vendor:authz": "node vendor-authz.cjs"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "axios": "^1.13.5",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "express": "^4.22.1",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^5.1.1",
    "rss-parser": "^3.13.0",
    "@durin-tech/authz": "file:vendor/authz"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "4.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.27",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "firebase": "11.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "private": true
}
