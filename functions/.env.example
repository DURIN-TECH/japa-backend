# ─────────────────────────────────────────────────────────────────────────────
# Backend Cloud Functions environment variables
#
# LOCAL / EMULATOR:  copy this file to `.env.local` and fill in real values.
#                    `.env.local` is git-ignored and loaded by the emulator only.
# PRODUCTION:        do NOT rely on this file. Set the secret values in Cloud
#                    Secret Manager:  firebase functions:secrets:set <NAME>
#                    (the `api` function binds them via runWith in src/index.ts)
# ─────────────────────────────────────────────────────────────────────────────

# Paystack billing provider --------------------------------------------------
# Test secret key from the Paystack dashboard (Settings → API Keys & Webhooks).
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where Paystack redirects the user after checkout completes. Keep this QUERY-FREE
# (no "?tab=…") — Paystack appends ?reference=…&trxref=…, and the account-settings
# page auto-opens the Subscription tab + confirms the payment when it sees them.
# Local dev → portal settings page; prod → the deployed portal URL.
PAYSTACK_CALLBACK_URL=http://localhost:3000/account-settings

# Optional: which billing provider to use. Defaults to "paystack" if unset.
# BILLING_PROVIDER=paystack

# Transactional email (Resend) -----------------------------------------------
# API key from the Resend dashboard (https://resend.com → API Keys).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Verified sender. The domain must be verified in Resend (DNS records) before
# real sends work. Format: "Display Name <address@your-verified-domain>".
EMAIL_FROM=Seli <info@weareseli.com>

# Dev override: use Resend's pre-verified onboarding address for local dev /
# non-production environments when your domain isn't yet verified (avoids 403).
# Resend restricts onboarding@resend.dev to your Resend account's email only.
# Ignored when NODE_ENV=production. Remove once the real domain is verified.
# EMAIL_FROM_DEV_OVERRIDE=onboarding@resend.dev

# Optional: which email provider to use. Defaults to "resend" if unset.
# EMAIL_PROVIDER=resend
