{
  // Type-check config for the unit tests in test/ (run by `npm test` before
  // the tests execute via tsx). Extends the build config but emits nothing, so
  // test files never end up in lib/ or in a functions deploy. Also type-checks
  // the visa extraction eval (src/scrapers/visa-catalog/eval/, issue #60),
  // which is likewise never compiled into lib/ (the build tsconfig excludes
  // it), so `exclude` is reset here to bring it back in.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["src/**/*", "test/**/*"],
  "exclude": ["node_modules"]
}
