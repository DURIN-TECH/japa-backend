# Dependencies
node_modules/

# Build output
lib/
dist/

# Vendored @durin-tech/authz — MUST be committed (re-included from the dist/ rule
# above) so `firebase deploy` ships it and the Functions cloud build needs no
# private-registry auth. Regenerate with `npm run vendor:authz`.
!functions/vendor/authz/dist/
!functions/vendor/authz/dist/**

# Environment files
.env
.env.local
.env.*.local

# Firebase
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# TypeScript cache
*.tsbuildinfo

key.json