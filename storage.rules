rules_version = '2';

// WHAT CLIENTS CAN REACH DIRECTLY (issue #141)
// Rules are deny-by-default: a path with no `match` below cannot be read or
// written with a client SDK by anyone. That is deliberate for every prefix
// the BACKEND uploads into or owns:
//   documents/…            application documents   (API: /documents)
//   verification/…         agent verification docs (API: /agents/me/verification)
//   compliance/…           agency KYC/KYB docs     (API: /agencies/me/compliance)
//   agency-logos/…         agency logos            (API: /agencies/me/logo)
//   guidance-snapshots/…   backend-only scraper snapshots
// The apps reach those only through the API, which authorises the caller and
// hands out short-lived signed URLs for validated paths
// (functions/src/utils/storage-paths.ts). Do NOT add a `match` for them.
//
// The matches below are older client-SDK paths. Neither the portal nor the
// mobile app reads or writes through the Storage SDK today, so reads that
// used to be open to "any signed-in user" are now admin-only: being signed in
// says nothing about whose file it is. Covered by
// functions/test/emulator/storage-rules.emu.ts.
service firebase.storage {
  match /b/{bucket}/o {
    
    // ============================================
    // HELPER FUNCTIONS
    // ============================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }
    
    function isAgent() {
      return isAuthenticated() && request.auth.token.agent == true;
    }
    
    // Check file size (in bytes)
    function isValidSize(maxSize) {
      return request.resource.size <= maxSize;
    }
    
    // Check content type
    function isValidContentType(types) {
      return request.resource.contentType.matches(types);
    }
    
    // ============================================
    // USER PROFILE PHOTOS
    // ============================================
    
    match /users/{userId}/profile/{fileName} {
      // Anyone can view profile photos
      allow read: if true;
      
      // Users can upload their own profile photos
      allow write: if isOwner(userId) &&
                     isValidSize(5 * 1024 * 1024) && // 5MB max
                     isValidContentType('image/(jpeg|png|gif|webp)');
      
      // Users can delete their own profile photos
      allow delete: if isOwner(userId) || isAdmin();
    }
    
    // ============================================
    // APPLICATION DOCUMENTS
    // ============================================
    
    match /applications/{applicationId}/documents/{fileName} {
      // Admins only. This used to be "any signed-in user", which let every
      // account read every object under this prefix (issue #141). Application
      // documents are served by the API from `documents/…` via signed URLs;
      // no client reads this path.
      allow read: if isAdmin();
      
      // Authenticated users can upload documents
      allow create: if isAuthenticated() &&
                      isValidSize(10 * 1024 * 1024) && // 10MB max
                      isValidContentType('(application/pdf|image/(jpeg|png|gif|webp))');
      
      // Allow updates (re-uploads)
      allow update: if isAuthenticated() &&
                      isValidSize(10 * 1024 * 1024) &&
                      isValidContentType('(application/pdf|image/(jpeg|png|gif|webp))');
      
      // Only admins can delete documents
      allow delete: if isAdmin();
    }
    
    // ============================================
    // AGENT VERIFICATION DOCUMENTS
    // ============================================
    
    match /agents/{agentId}/verification/{fileName} {
      // Agents can upload their verification documents
      // Admins can view verification documents
      allow read: if isAdmin() || 
                    (isAuthenticated() && 
                     exists(/databases/(default)/documents/agents/$(agentId)) &&
                     get(/databases/(default)/documents/agents/$(agentId)).data.userId == request.auth.uid);
      
      allow write: if isAuthenticated() &&
                     isValidSize(10 * 1024 * 1024) &&
                     isValidContentType('(application/pdf|image/(jpeg|png|gif|webp))');
      
      allow delete: if isAdmin();
    }
    
    // ============================================
    // CONSULTATION RECORDINGS
    // ============================================
    
    match /consultations/{consultationId}/recordings/{fileName} {
      // Admins only (was "any signed-in user"; issue #141). Rules cannot tell
      // who took part in a consultation, so participant access must go
      // through the API if recordings are ever served.
      allow read: if isAdmin();
      
      // Only system can upload recordings (via Cloud Functions)
      allow write: if false;
      
      allow delete: if isAdmin();
    }
    
    // ============================================
    // MESSAGE ATTACHMENTS
    // ============================================
    
    match /messages/{conversationId}/{fileName} {
      // Admins only (was "any signed-in user"; issue #141). Rules cannot tell
      // who the conversation's participants are, so attachment access must go
      // through the API if attachments are ever uploaded here.
      allow read: if isAdmin();
      
      // Authenticated users can upload attachments
      allow create: if isAuthenticated() &&
                      isValidSize(10 * 1024 * 1024) &&
                      isValidContentType('(application/pdf|image/(jpeg|png|gif|webp)|video/mp4)');
      
      // Attachments cannot be updated
      allow update: if false;
      
      // Only admins can delete attachments
      allow delete: if isAdmin();
    }
    
    // ============================================
    // TEMP UPLOADS (for processing)
    // ============================================
    
    match /temp/{userId}/{fileName} {
      // Users can manage their own temp files
      allow read, write: if isOwner(userId) &&
                           isValidSize(20 * 1024 * 1024);
      
      allow delete: if isOwner(userId) || isAdmin();
    }
  }
}
