# ============================================================
# Seli API Testing
#
# First-time setup:
#   cp -r .vscode.sample .vscode
#   Then for production, replace YOUR_FIREBASE_API_KEY in
#   .vscode/settings.json with your real key from Firebase console.
#
# Switch environments in VS Code status bar (bottom right):
#   - "local"      → Firebase emulator (localhost)
#   - "production" → Deployed Cloud Functions
# ============================================================

# ============================================================
# AUTH — Sign in as different user types
# Run ONE of these first, then use the token in requests below.
# ============================================================

### Sign in as Admin
# @name loginAdmin
POST {{authUrl}}/accounts:signInWithPassword?key={{apiKey}}
Content-Type: application/json

{
    "email": "{{adminEmail}}",
    "password": "{{password}}",
    "returnSecureToken": true
}

###
@adminToken = {{loginAdmin.response.body.idToken}}
@refreshToken = {{loginAdmin.response.body.refreshToken}}


### Sign in as Agency Owner
# @name loginOwner
POST {{authUrl}}/accounts:signInWithPassword?key={{apiKey}}
Content-Type: application/json

{
    "email": "{{ownerEmail}}",
    "password": "{{password}}",
    "returnSecureToken": true
}

###
@ownerToken = {{loginOwner.response.body.idToken}}

### Sign in as Agent 1
# @name loginAgent1
POST {{authUrl}}/accounts:signInWithPassword?key={{apiKey}}
Content-Type: application/json

{
    "email": "{{agent1Email}}",
    "password": "{{password}}",
    "returnSecureToken": true
}

###
@agent1Token = {{loginAgent1.response.body.idToken}}

### Sign in as Agent 2
# @name loginAgent2
POST {{authUrl}}/accounts:signInWithPassword?key={{apiKey}}
Content-Type: application/json

{
    "email": "{{agent2Email}}",
    "password": "{{password}}",
    "returnSecureToken": true
}

###
@agent2Token = {{loginAgent2.response.body.idToken}}

### Sign in as Client (John Doe)
# @name loginClient
POST {{authUrl}}/accounts:signInWithPassword?key={{apiKey}}
Content-Type: application/json

{
    "email": "{{clientEmail}}",
    "password": "{{password}}",
    "returnSecureToken": true
}

###
@clientToken = {{loginClient.response.body.idToken}}

# ============================================================
# HEALTH
# ============================================================

### Health check (no auth needed)
GET {{baseUrl}}/health

# ============================================================
# USERS
# ============================================================

### Get my profile (as admin)
GET {{baseUrl}}/users/me
Authorization: Bearer {{adminToken}}

### Get my profile (as owner)
GET {{baseUrl}}/users/me
Authorization: Bearer {{ownerToken}}

### Get my profile (as agent)
GET {{baseUrl}}/users/me
Authorization: Bearer {{agent1Token}}

### Record login
POST {{baseUrl}}/users/login
Authorization: Bearer {{adminToken}}

# ============================================================
# AGENTS
# ============================================================

### Get all agents (public)
# Issue #179: each agent carries consultationFeeUsd { amountMinor (US cents), currency: "USD" }
# and consultationFeeLocal { amountMinor, currency, rate, asOf, available }.
# available:false (rate stale/missing) -> show the dollar price only.
GET {{baseUrl}}/agents

### Get agent profile (as agent1)
GET {{baseUrl}}/agents/me
Authorization: Bearer {{agent1Token}}

### Get agent by ID
GET {{baseUrl}}/agents/seed-user-agent-001
Authorization: Bearer {{adminToken}}

### Set my consultation fee in US dollars (issue #179). Whole cents, at most
### $100,000.00, currency USD only (optional). The old naira `consultationFee` is a 400.
PUT {{baseUrl}}/agents/me
Content-Type: application/json
Authorization: Bearer {{agent1Token}}

{ "consultationFeeUsd": { "amount": "10.00", "currency": "USD" } }

# ============================================================
# AGENCIES
# ============================================================

### Public agency directory (no auth, #144): approved agencies, newest first
GET {{baseUrl}}/agencies/browse

### Public agency directory: search by name, capped list (limit max 100)
GET {{baseUrl}}/agencies/browse?search=acme&limit=10

### Public agency profile by id, with visaPrices[] (no auth; 404 unless approved)
GET {{baseUrl}}/agencies/browse/seed-agency-001

### Public agency's verified + available agents (no auth; 404 unless approved)
GET {{baseUrl}}/agencies/browse/seed-agency-001/agents

### Public agency landing page by slug, with visaPrices[] (no auth)
GET {{baseUrl}}/agencies/public/acme

### Get my agency (as owner)
GET {{baseUrl}}/agencies/me
Authorization: Bearer {{ownerToken}}

### Set the agency fee and services in US dollars (issue #179, owner only).
### consultationFeeUsd: null clears the fee. Old naira keys (consultationFee,
### services[].price) are a 400.
PUT {{baseUrl}}/agencies/me
Content-Type: application/json
Authorization: Bearer {{ownerToken}}

{
  "consultationFeeUsd": { "amount": "100.00", "currency": "USD" },
  "services": [
    { "id": "svc-1", "name": "Visa Application Processing", "priceUsd": { "amount": "50.00" } }
  ]
}

### List this agency's visa service prices (priceUsd, US cents)
GET {{baseUrl}}/agency/visa-prices
Authorization: Bearer {{ownerToken}}

### Set one visa's service price in US dollars ({ "priceUsd": null } clears it)
PUT {{baseUrl}}/agency/visa-prices/GB/uk-student
Content-Type: application/json
Authorization: Bearer {{ownerToken}}

{ "priceUsd": { "amount": "125.00", "currency": "USD" } }

### Get all agencies (admin)
GET {{baseUrl}}/agencies
Authorization: Bearer {{adminToken}}

### Get pending agencies (admin)
GET {{baseUrl}}/agencies/pending
Authorization: Bearer {{adminToken}}

