rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // =====================================    // HELPER FUNCTIONS
    // =====================================    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Check if user is an admin (via custom claims)
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }
    
    // Check if user is a verified agent
    function isAgent() {
      return isAuthenticated() && request.auth.token.agent == true;
    }

    // ---- RBAC role-claim helpers (canonical claims: role + agencyId) ----
    // The current auth system stores a `role` claim (admin/owner/agent/client)
    // and an `agencyId` claim, keeping the legacy `admin` boolean in sync. These
    // helpers key off the canonical `role` claim (with legacy fallbacks) so rules
    // stay correct for tokens minted by the RBAC layer.

    // Any agent-side principal: agent, owner, or admin.
    function isAgentSide() {
      return isAuthenticated() &&
        (request.auth.token.role in ['agent', 'owner', 'admin'] ||
         request.auth.token.admin == true);
    }

    // Agency owner scoped to a specific agency (via the agencyId claim).
    function isAgencyOwner(agencyId) {
      return isAuthenticated() &&
        request.auth.token.role == 'owner' &&
        agencyId != null &&
        request.auth.token.agencyId == agencyId;
    }

    // Check if request has valid data
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }
    
    // =====================================    // USERS COLLECTION
    // =====================================    
    match /users/{userId} {
      // ---- Self-editable profile fields (ALLOW-LIST, issue #135) ----
      // The ONLY fields a signed-in user may write on their own profile from
      // a client SDK. Everything else on the document is written by the
      // backend (Admin SDK, which bypasses these rules), because the backend
      // treats it as authority or keeps it in step with another system:
      //  - admin: legacy admin flag. Still read to pick who receives admin
      //    notifications (compliance submissions, scraper alerts). The role
      //    itself comes from the custom claim, never from this field.
      //  - role, agencyId, agencyRole: role and agency membership live in
      //    custom claims and on the agent document; they must never be
      //    assertable from a profile.
      //  - identityVerification: the applicant's KYC result.
      //  - isProvisional: marks an account an agent created for a client.
      //  - email: where notifications are sent; changed only through the
      //    verified change-email flow.
      //  - id, createdAt, onboardingCompleted(+At), lastLoginAt, fcmTokens:
      //    server-managed.
      // An allow-list (not a deny-list) so a field added later is protected
      // until someone decides it is safe. No portal or mobile code writes
      // this collection directly today (both go through the API), so nothing
      // legitimate is lost. Keep in step with USER_SELF_EDITABLE_FIELDS in
      // functions/src/services/user.service.ts (the API-side allow-list).
      function selfEditableUserFields() {
        return ['firstName', 'lastName', 'middleName', 'phone', 'dateOfBirth',
                'address', 'residentialCountry', 'profilePhotoUrl',
                'hasPassport', 'passportNumber', 'passportExpiryDate',
                'passportCountry', 'notificationPreferences', 'updatedAt'];
      }

      // Users can read their own profile
      allow read: if isOwner(userId);

      // Users can create their own profile, with profile fields only. The
      // identity fields may be present but must tell the truth: `id` is the
      // document id and `email` is the address on the token.
      allow create: if isOwner(userId) &&
                      request.resource.data.keys().hasOnly(
                        selfEditableUserFields().concat(['id', 'email', 'createdAt'])) &&
                      request.resource.data.get('id', userId) == userId &&
                      request.resource.data.get('email', request.auth.token.get('email', null))
                        == request.auth.token.get('email', null);

      // Users can update their own profile: only allow-listed fields may be
      // added, changed or removed.
      allow update: if isOwner(userId) &&
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(selfEditableUserFields());

      // Only admins can delete users
      allow delete: if isAdmin();
    }
    
    // =====================================    // AGENTS COLLECTION
    // =====================================    
    match /agents/{agentId} {
      // Anyone can read verified agents
      allow read: if resource.data.verificationStatus == 'verified' || 
                    isAdmin() ||
                    (isAuthenticated() && resource.data.userId == request.auth.uid);
      
      // ---- Self-editable agent profile fields (ALLOW-LIST, issue #135) ----
      // The ONLY fields an agent may write on their own agent document from a
      // client SDK. Everything else is written by the backend (Admin SDK),
      // because it decides what the agent may do or how they are presented:
      //  - agencyId, agencyRole: agency membership and ownership. Written
      //    only by owner onboarding, invitation acceptance and the agency
      //    member endpoints; the role lookup reads them.
      //  - verificationStatus, verifiedAt, verifiedBy, verificationDocuments:
      //    the admin / agency-owner verification decision and its evidence.
      //  - userId: who the profile belongs to (fixed at creation).
      //  - isAvailable: only a verified agent may switch it on (API check).
      //  - rating, totalReviews, totalApplications, successRate,
      //    responseTime: computed marketplace stats.
      //  - id, createdAt: server-managed.
      // No portal or mobile code writes this collection directly today (both
      // use the API). Keep in step with AGENT_SELF_EDITABLE_FIELDS in
      // functions/src/services/agent.service.ts (the API-side allow-list).
      function selfEditableAgentFields() {
        return ['displayName', 'bio', 'profilePhotoUrl', 'licenseNumber',
                'yearsOfExperience', 'specializations', 'languages',
                'featuredVisas', 'consultationFee', 'serviceFees',
                'availableSlots', 'updatedAt'];
      }

      // Authenticated users can create their own agent profile, with profile
      // fields only: no agency, no verification state, no stats.
      allow create: if isAuthenticated() &&
                      request.resource.data.userId == request.auth.uid &&
                      request.resource.data.keys().hasOnly(
                        selfEditableAgentFields().concat(['id', 'userId', 'createdAt'])) &&
                      request.resource.data.get('id', agentId) == agentId;

      // Agents can update the allow-listed fields of their own profile.
      // Admins (by custom claim) can update any field.
      allow update: if isAdmin() ||
                      (isAuthenticated() &&
                       resource.data.userId == request.auth.uid &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(selfEditableAgentFields()));

      // Only admins can delete agents
      allow delete: if isAdmin();
      
      // Agent reviews subcollection
      match /reviews/{reviewId} {
        // Anyone can read reviews
        allow read: if true;
        
        // Authenticated users can create reviews
        allow create: if isAuthenticated() && 
                        request.resource.data.userId == request.auth.uid;
        
        // Users can update their own reviews
        allow update: if isOwner(resource.data.userId);
        
        // Users can delete their own reviews, admins can delete any
        allow delete: if isOwner(resource.data.userId) || isAdmin();
      }
    }
    
    // =====================================    // COUNTRIES COLLECTION
    // =====================================    
    match /countries/{countryCode} {
      // Anyone can read countries
      allow read: if true;
      
      // Only admins can write countries
      allow write: if isAdmin();
      
      // Visa types subcollection
      match /visaTypes/{visaTypeId} {
        // Issue #102: the direct-read twin of the backend's public visibility
        // rule (`isVisaPubliclyVisible`, functions/src/services/visa.service.ts).
        // A visa doc is client-readable only when ALL of these hold:
        //  1. isActive == true;
        //  2. visibility is "global" or missing/null (seed and scraped docs
        //     predate the field). An approved AGENCY-ONLY visa is reachable
        //     only through the backend (#102), never by a direct read;
        //  3. reviewStatus is "approved" or missing/null (seed docs). Draft,
        //     pending_review and rejected visas are never client-readable.
        // `get(field, null)` makes a missing field read as null instead of
        // failing the rule. Before #102 the rule was `isActive == true`
        // alone, which let any client read an approved agency-only visa
        // (bypassing the API rule). Admins can read any visa.
        function isPubliclyVisibleVisa(data) {
          return data.isActive == true &&
            data.get('visibility', null) in [null, 'global'] &&
            data.get('reviewStatus', null) in [null, 'approved'];
        }

        allow read: if isPubliclyVisibleVisa(resource.data) || isAdmin();
        
        // Only admins can write visa types
        allow write: if isAdmin();
        
        // Requirements subcollection
        match /requirements/{requirementId} {
          // Issue #102: requirements follow their visa. Readable only when the
          // parent visa is publicly visible (same rule as above), or by an
          // admin. Before #102 this was `if true`, so a hidden visa's
          // requirements were readable by anyone who knew its id.
          allow read: if isAdmin() ||
            isPubliclyVisibleVisa(
              get(/databases/$(database)/documents/countries/$(countryCode)/visaTypes/$(visaTypeId)).data
            );
          
          // Only admins can write requirements
          allow write: if isAdmin();
        }
      }
    }
    
    // =====================================    // APPLICATIONS COLLECTION
    // =====================================    
    match /applications/{applicationId} {
      // Users can read their own applications
      // Agents can read applications assigned to them
      allow read: if isOwner(resource.data.userId) ||
                    (isAgent() && resource.data.agentId != null && 
                     exists(/databases/$(database)/documents/agents/$(resource.data.agentId)) &&
                     get(/databases/$(database)/documents/agents/$(resource.data.agentId)).data.userId == request.auth.uid) ||
                    isAdmin();
      
      // ---- Applications are written ONLY by the backend (issue #138) ----
      // Every create and update goes through the API (Admin SDK, which
      // bypasses these rules): POST /applications, POST /applications/for-client,
      // PUT /applications/:id (notes; assignment by the agent side),
      // PUT /applications/:id/status, and the payment / document flows.
      // No portal or mobile code writes this collection from a client SDK.
      //
      // Why not an allow-list of "harmless" fields: nearly every field on an
      // application is a decision somebody else makes or relies on:
      //  - status, currentStep, nextStep, rejectionReason: the progress of
      //    the case, set by the agent side (the applicant may only withdraw,
      //    and that goes through the API too);
      //  - agentId, agencyId, mode, createdVia: who handles the case and who
      //    may read it and its documents (the API's access check and the
      //    compliance gate on taking platform clients read these);
      //  - userId, clientName, clientEmail: whose case it is;
      //  - paymentStatus, totalFee, amountPaid and the other money fields:
      //    written by the payment flows.
      // The two free-text fields a participant may edit (userNotes for the
      // applicant, agentNotes for the agent side) are edited through
      // PUT /applications/:id, which decides who may write which.
      allow create, update: if false;

      // Only admins can delete applications
      allow delete: if isAdmin();
      
      // NOTE (issue #28): there is deliberately NO `documents` subcollection
      // rule here. Application documents live in the TOP-LEVEL `documents`
      // collection, which is backend-only (see the list at the bottom of this
      // file). The old `match /documents/{documentId}` block that stood here
      // granted access to a path nothing writes to, and let ANY agent read
      // it; it was deleted as dead rather than ported.

      // Timeline subcollection
      match /timeline/{timelineId} {
        allow read: if isOwner(get(/databases/$(database)/documents/applications/$(applicationId)).data.userId) ||
                      isAgent() || isAdmin();

        // The timeline is the record of status changes. It is written only
        // by the backend, alongside the status change itself (issue #138).
        allow write: if false;
      }

      // Answers subcollection (issue #187): the applicant's typed answers to
      // "information" checklist items. Personal data, so NO client access at
      // all: read and written only through GET / PUT
      // /applications/:id/answers[/:itemId], which run the application
      // access check. Admin SDK bypasses these rules.
      match /answers/{itemId} {
        allow read, write: if false;
      }

      // Notes subcollection
      match /notes/{noteId} {
        // Application access holders can read notes
        allow read: if isOwner(get(/databases/$(database)/documents/applications/$(applicationId)).data.userId) ||
                      isAgent() || isAdmin();

        // Notes are written ONLY by the backend (issue #138), through
        // POST / PUT / DELETE /applications/:id/notes[/:noteId], which checks
        // that the caller has access to THIS application and stamps the
        // author. A client rule cannot make that check cheaply, and the old
        // one did not: it let any signed-in user add a note to any
        // application. No portal or mobile code writes notes from a client SDK.
        allow write: if false;
      }
    }

    // =====================================    // AGENCIES COLLECTION
    // =====================================
    match /agencies/{agencyId} {
      // The agency owner and admins can read. (`agentIds` is not written by
      // any current flow, so in practice members read their agency through
      // GET /agencies/me, which redacts the compliance file for them.)
      allow read: if isAuthenticated() &&
                    (resource.data.ownerId == request.auth.uid ||
                     request.auth.uid in resource.data.agentIds ||
                     isAdmin());

      // ---- Owner-editable agency profile (ALLOW-LIST, issue #138) ----
      // The ONLY fields the owner may change from a client SDK. This list is
      // the same one the API copies (AGENCY_OWNER_EDITABLE_FIELDS in
      // functions/src/services/agency.service.ts).
      function ownerEditableAgencyFields() {
        return [
          'name',
          'address',
          'state',
          'description',
          'consultationFee',
          'services'
        ];
      }

      // The agency's owner, as recorded on the document (not by claim): the
      // claim is derived from this field, so only the record may name it.
      function isRecordedOwner() {
        return isAuthenticated() && resource.data.ownerId == request.auth.uid;
      }

      // ---- Creation is backend-only (issue #138) ----
      // Creating an agency starts the owner's role, the admin's review queue
      // and the seat count. It goes through owner onboarding or POST
      // /agencies (Admin SDK), which always writes `pending_review`, no
      // compliance file, one member and a server-generated slug. A client
      // create would have to name its own ownerId and seat count, so it is
      // refused outright.
      allow create: if false;

      // ---- Update: the owner-editable profile and nothing else ----
      // `diff().affectedKeys().hasOnly(...)` makes every other field
      // server-written, whether or not anybody has thought of it yet:
      //  - status (+ reviewedBy, reviewedAt, rejectionReason): the admin's
      //    admission decision (public page, admin review queue);
      //  - compliance (the whole KYC/KYB/payout file, either key or any
      //    nested field, and its review metadata): the gate on payment
      //    requests and on taking platform clients. Its fields are edited
      //    through /agencies/me/compliance, which locks the file once
      //    submitted;
      //  - ownerId: the ownership anchor. The role lookup grants the owner
      //    role only when the agency names the user (claims.service.ts), and
      //    the owner endpoints check it;
      //  - ownerName, slug, id: server-managed identity;
      //  - totalAgents: the seat check on invitations counts from it;
      //    totalCases / activeCases: stats;
      //  - logoUrl: set only by the logo endpoints, after validating the
      //    upload (issue #141);
      //  - createdAt / updatedAt: timestamps the server writes.
      // A document overwrite that drops a protected field is refused too:
      // the removed key appears in affectedKeys(). The API applies the same
      // allow-list and type checks (PUT /agencies/me).
      allow update: if isRecordedOwner() &&
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(ownerEditableAgencyFields());

      // Only admin can delete agencies
      allow delete: if isAdmin();

      // Per-visa service prices (issue #103), written and read only by the
      // backend (Admin SDK, which bypasses rules). Issue #102: an explicit
      // deny, so a later broad rule on agencies/{agencyId} can never open it
      // by accident (a parent match does not cover subcollections today, but
      // this makes the intent impossible to miss). The public page serves the
      // prices through GET /agencies/public/:slug.
      match /visaPrices/{priceId} {
        allow read, write: if false;
      }
    }

    // =====================================    // AGENCY INVITATIONS COLLECTION
    // =====================================
    match /agencyInvitations/{invitationId} {
      // Agency owner can read their invitations
      // Invitee can read invitations sent to them
      allow read: if isAuthenticated() &&
                    (resource.data.invitedBy == request.auth.uid ||
                     resource.data.email == request.auth.token.email ||
                     isAdmin());

      // Invitations are written ONLY by the backend (Admin SDK), through the
      // API (issue #135). Redeeming an invitation turns it into agency
      // membership, so a client must never be able to write one. What the API
      // checks:
      //  - creating: the caller is the `ownerId` of the agency;
      //  - redeeming (accept / join-agency): the agency exists and its
      //    `ownerId` is the invitation's `invitedBy`; the invitation is
      //    pending and not expired; and the caller's token email equals
      //    `invitedEmail` (a token with no email is refused). The API does
      //    NOT require that email to be verified.
      // No portal or mobile code writes this collection directly.
      allow create, update: if false;

      // Only admin can delete invitations
      allow delete: if isAdmin();
    }

    // =====================================    // CONSULTATIONS COLLECTION
    // =====================================    
    match /consultations/{consultationId} {
      // Users can read their own consultations
      // Agents can read their consultations
      allow read: if isOwner(resource.data.userId) ||
                    (isAgent() && 
                     exists(/databases/$(database)/documents/agents/$(resource.data.agentId)) &&
                     get(/databases/$(database)/documents/agents/$(resource.data.agentId)).data.userId == request.auth.uid) ||
                    isAdmin();
      
      // Users can create consultations
      allow create: if isAuthenticated() && 
                      request.resource.data.userId == request.auth.uid;
      
      // Users and agents can update consultations
      allow update: if isOwner(resource.data.userId) ||
                      (isAgent() &&
                       exists(/databases/$(database)/documents/agents/$(resource.data.agentId)) &&
                       get(/databases/$(database)/documents/agents/$(resource.data.agentId)).data.userId == request.auth.uid) ||
                      isAdmin();
      
      // Only admins can delete consultations
      allow delete: if isAdmin();
    }
    
    // =====================================    // TRANSACTIONS COLLECTION
    // =====================================    
    match /transactions/{transactionId} {
      // Users can read their own transactions
      allow read: if isOwner(resource.data.userId) || isAdmin();
      
      // Only system (via Cloud Functions) can create/update transactions
      allow write: if false;
    }
    
    // =====================================    // NOTIFICATIONS COLLECTION
    // =====================================    
    match /notifications/{notificationId} {
      // Users can read their own notifications
      allow read: if isOwner(resource.data.userId);
      
      // Users can update their notifications (mark as read)
      allow update: if isOwner(resource.data.userId) &&
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['isRead', 'readAt']);
      
      // Only system can create notifications
      allow create: if false;
      
      // Users can delete their own notifications
      allow delete: if isOwner(resource.data.userId);
    }
    
    // =====================================    // CONVERSATIONS COLLECTION
    // =====================================    
    match /conversations/{conversationId} {
      // Participants can read conversations
      allow read: if isAuthenticated() &&
                    (resource.data.userId == request.auth.uid ||
                     (exists(/databases/$(database)/documents/agents/$(resource.data.agentId)) &&
                      get(/databases/$(database)/documents/agents/$(resource.data.agentId)).data.userId == request.auth.uid));
      
      // AI message access (issues #172, #209): WHO the two sides are must not be
      // client-writable. The per-chat switch fields (`aiAccessOffUser/Agent`) are
      // RETIRED (#209): nothing writes or reads them any more, and clients still
      // cannot write them (the allow-list below and the create check).
      //
      // Updates are an ALLOW-LIST, not a deny-list. The AI access check resolves
      // the two people of a chat from `conv.userId` / `conv.agentId`, and the rule
      // only checks the document as it was BEFORE the write, so a participant who
      // could rewrite either id could make the check see the wrong people. A client
      // may therefore update only the fields below. No client code writes this
      // document today (mobile and portal only read it, through the API or a
      // listener); the API writes everything else with the Admin SDK.
      function onlyClientEditableConversationFields() {
        return request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['unreadCountUser', 'unreadCountAgent', 'updatedAt']);
      }

      // Authenticated users can create conversations (but cannot create one that
      // already carries a chat switch value).
      allow create: if isAuthenticated() && 
                      request.resource.data.userId == request.auth.uid &&
                      !request.resource.data.keys().hasAny(['aiAccessOffUser', 'aiAccessOffAgent']);
      
      // Participants can update only the allow-listed fields.
      allow update: if isAuthenticated() &&
                      onlyClientEditableConversationFields() &&
                      (resource.data.userId == request.auth.uid ||
                       (exists(/databases/$(database)/documents/agents/$(resource.data.agentId)) &&
                        get(/databases/$(database)/documents/agents/$(resource.data.agentId)).data.userId == request.auth.uid));
      
      allow delete: if isAdmin();
      
      // Messages subcollection
      match /messages/{messageId} {
        // Participants can read messages
        allow read: if isAuthenticated() &&
                      (get(/databases/$(database)/documents/conversations/$(conversationId)).data.userId == request.auth.uid ||
                       (exists(/databases/$(database)/documents/agents/$(get(/databases/$(database)/documents/conversations/$(conversationId)).data.agentId)) &&
                        get(/databases/$(database)/documents/agents/$(get(/databases/$(database)/documents/conversations/$(conversationId)).data.agentId)).data.userId == request.auth.uid));
        
        // Participants can create messages
        allow create: if isAuthenticated() && 
                        request.resource.data.senderId == request.auth.uid;
        
        // Messages cannot be updated or deleted
        allow update, delete: if false;
      }
    }

    // =====================================    // DOCUMENT TEMPLATES COLLECTION
    // =====================================    //
    // Read-only clonable catalog. All writes go through the backend (Admin SDK,
    // which bypasses these rules) — there is no client authoring path — so direct
    // writes are denied. Reads are agent-side only and scope-limited: everyone
    // sees "global" templates; "agency" templates only within the owning agency.

    match /documentTemplates/{templateId} {
      allow read: if isAdmin() ||
                    (isAgentSide() &&
                     (resource.data.scope == 'global' ||
                      resource.data.get('agencyId', null) == request.auth.token.agencyId));

      // Seeded / authored exclusively via the backend.
      allow write: if false;
    }

    // =====================================    // DOCUMENT INSTANCES COLLECTION
    // =====================================    //
    // Editable documents cloned from templates. Every mutation (clone, save,
    // link, share, delete) goes through the API, which enforces authorization and
    // optimistic-concurrency versioning — so direct client writes are denied to
    // prevent bypassing the version check. Reads are granted to:
    //   - the authoring agent (createdBy)
    //   - the owning agency's owner (agencyId matches the owner's claim)
    //   - platform admins
    //   - the linked application's client, but ONLY once the doc is shared
    //     (supports the mobile "share with client" phase)

    match /documentInstances/{instanceId} {
      // Reusable read predicate (also used by the versions subcollection).
      function canReadInstance() {
        return isAdmin() ||
          (isAuthenticated() && resource.data.createdBy == request.auth.uid) ||
          isAgencyOwner(resource.data.get('agencyId', null)) ||
          (resource.data.shareStatus == 'shared' &&
           resource.data.applicationId != null &&
           isOwner(
             get(/databases/$(database)/documents/applications/$(resource.data.applicationId)).data.userId
           ));
      }

      allow read: if canReadInstance();

      // All writes flow through the backend (Admin SDK), which owns the version
      // increment + snapshot. No direct client writes.
      allow write: if false;

      // Immutable content snapshots (version history). Same read scope as the
      // parent instance; the parent doc is fetched to evaluate access. Written
      // only by the backend alongside each save.
      match /versions/{versionId} {
        function parentInstance() {
          return get(/databases/$(database)/documents/documentInstances/$(instanceId)).data;
        }

        allow read: if isAdmin() ||
          (isAuthenticated() && parentInstance().createdBy == request.auth.uid) ||
          isAgencyOwner(parentInstance().get('agencyId', null)) ||
          (parentInstance().shareStatus == 'shared' &&
           parentInstance().applicationId != null &&
           isOwner(
             get(/databases/$(database)/documents/applications/$(parentInstance().get('applicationId', null))).data.userId
           ));

        allow write: if false;
      }
    }

    // ---- Backend-only collections: deliberately NO match block ----
    // Firestore denies by default, so with no `match` here every client read
    // and write is refused; only the backend (Admin SDK, which bypasses rules)
    // touches them:
    //  - documents/{documentId}: uploaded application documents (issue #28).
    //    Clients never read these from Firestore: portal and mobile go through
    //    the API (GET /applications/:id/documents, GET /documents/:id[/download]),
    //    which authorizes per application with the shared CASL ability (the
    //    applicant, the assigned agent, the owner of the same agency, admins).
    //    Do NOT add a match: a rule here could only widen that access.
    //  - appConfig/{docId}: backend config, e.g. appConfig/fx exchange rates
    //    (issue #59).
    //  - exchangeRates/{currency} and exchangeRateAudit/{id}: the rate used to
    //    price in a local currency, any admin override of it and the history
    //    of overrides (issue #178). The public rate view is GET /rates;
    //    overrides go through /admin/exchange-rates only. A client write here
    //    would let a user set their own price. Do NOT add a match.
    //  - pendingVisaChanges/{changeId}: proposed field-level edits to
    //    approved scraped visas, staged by the crawl and approved/rejected by
    //    admins via /admin/visa-changes (issue #61). Do NOT add a match.
    //  - riskSignals/{signalId} (+ its append-only /events audit trail):
    //    trafficking / scam signals for a human to review (issue #119). Admins
    //    read and decide them through /admin/risk-signals only, so the subject
    //    and every other client principal can never see a signal or a count of
    //    signals. Do NOT add a match, not even an admin one.
    //  - listingScreenings/{countryCode}__{visaId}: the screening result of an
    //    agency-created visa listing (code comparison with the verified record,
    //    validated language flags with the listing's own quotes, signal ids,
    //    issue #120). Admins read it only through GET /admin/visas and the
    //    rerun route, so the agency and applicants can never see it. Do NOT add
    //    a match, not even an admin one.
    //  - guidanceSources/{sourceId} and its snapshots/{contentHash}
    //    subcollection: the caseworker-guidance source registry and the
    //    metadata of its immutable text snapshots (issue #39). Admins read
    //    the registry via GET /admin/guidance-sources. Do NOT add a match.
    //  - visaRubrics/{routeKey} and its rubricVersions/{version}
    //    subcollection, and rubricExtractionRuns/{runId}: rubrics extracted
    //    from caseworker guidance, staged `pending_review` for an admin, and
    //    the record of each extraction run (issue #40). Consumers only ever
    //    get an APPROVED version, through the backend. Do NOT add a match.
    //  - rubricReviewHistory/{entryId}: audit trail of rubric review
    //    decisions (who approved or rejected which version, why, and which
    //    flags they acknowledged), written with each decision by the admin
    //    review API, /admin/rubrics (issue #125). Do NOT add a match.
    //  - rubricPublishRuns/{routeKey}__v{version} and
    //    rubricPublishSettingsHistory/{entryId}: the record of each automatic
    //    rulebook publish run (gates, leave-outs, outcome) and the audit trail
    //    of changes to the publish settings (issue #201). Backend only: an
    //    applicant must never see internal notes. Do NOT add a match.

    //  - ruleChangeEvents/{eventId} and ruleChangeNotices/{eventId}__{appId}:
    //    one event per ADMIN-APPROVED rule or visa-record change, and one
    //    dedupe claim per application it was handled for (who was told what,
    //    issue #123). Written by the backend only. Do NOT add a match.

    //  - documentChecks/{documentId} and documentCheckCaps/{id}: per-upload
    //    document checks and their daily cost counters (issue #115). Clients read
    //    the check only through GET /documents/:id/check (tier-trimmed). Do NOT
    //    add a match.

    // ---- Agency visa revisions (issue #100), explicit deny (issue #102) ----
    // visaRevisions/{cc}__{visaId}: unreviewed agency edits to an approved
    // visa. Backend only (agency read via /agency/visas, admin review via
    // /admin/visas). Denied for every client, admins included, so the
    // unreviewed text can never be read or forged directly.
    match /visaRevisions/{revisionId} {
      allow read, write: if false;
    }
  }
}
